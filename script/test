#!/bin/sh
#
# Smoke test: run the BenBalter and AIPatterns styles against fixtures in testdata/ and assert
# each rule fires on prose crafted to trip it. Catches broken YAML, renamed
# rules, or regexes that silently stop matching. Not exhaustive — one positive
# case per rule under test.

set -e

if ! [ -x "$(command -v vale)" ]; then
	echo "Vale not found. Install from https://vale.sh to run the tests." >&2
	exit 1
fi

# Point Vale's default styles directory at this repo too. Otherwise a
# BenBalter style installed globally (e.g. by `vale sync` elsewhere, under
# ~/Library/Application Support/vale/styles on macOS) loads first and the
# tests silently run against that copy instead of the rules in this checkout.
export VALE_STYLES_PATH="$(pwd)"

# Throwaway config: enable the local style against the fixtures.
cfg="$(mktemp)"
trap 'rm -f "$cfg"' EXIT
cat > "$cfg" <<EOF
StylesPath = $(pwd)
MinAlertLevel = suggestion

[*.md]
BasedOnStyles = BenBalter, AIPatterns
EOF

# Vale exits non-zero when it finds alerts, which is exactly what we want here,
# so don't let `set -e` abort on it.
out="$(vale --config="$cfg" --output=JSON testdata/*.md || true)"

fail=0
assert_fires() {
	if printf '%s' "$out" | grep -q "\"$1\""; then
		echo "ok    $1 fires"
	else
		echo "FAIL  $1 did not fire on its fixture"
		fail=1
	fi
}

assert_fires "BenBalter.Buzzwords"
assert_fires "BenBalter.Assumptive"
assert_fires "BenBalter.Cliches"
assert_fires "BenBalter.CulturalInclusion"
assert_fires "AIPatterns.EmDash"
assert_fires "AIPatterns.MetaCommentary"
assert_fires "AIPatterns.ChatbotArtifacts"

# Clean fixture must trip nothing — catches rules that became overzealous
# (false positives), the direction "does it fire?" tests miss.
clean_out="$(vale --config="$cfg" --output=JSON testdata/clean.md || true)"
clean_hits="$(printf '%s' "$clean_out" | grep -c -E '"Check":"(BenBalter|AIPatterns)' || true)"
if [ "$clean_hits" -eq 0 ]; then
	echo "ok    clean fixture trips nothing"
else
	echo "FAIL  clean fixture produced $clean_hits alert(s):"
	printf '%s\n' "$clean_out" | grep -o -E '"Check":"(BenBalter|AIPatterns)[^"]*"'
	fail=1
fi

if [ "$fail" -ne 0 ]; then
	echo "Tests failed." >&2
	exit 1
fi
echo "All tests passed."

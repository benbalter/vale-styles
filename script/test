#!/bin/sh
#
# Golden-file tests for every rule: each fixtures/<Style>.<Rule>/ enables one
# rule, and testdata/<Style>.<Rule>.ct holds the exact Vale output expected for
# it (rule, line, column, message). fixtures/clean runs every rule against plain
# prose and must trip nothing. See main_test.go.
#
# After an intended change, regenerate the expected output and review the diff:
#
#   script/test -update

set -e

for cmd in go vale; do
	if ! [ -x "$(command -v "$cmd")" ]; then
		echo "$cmd not found. Install Go (https://go.dev) and Vale (https://vale.sh) to run the tests." >&2
		exit 1
	fi
done

exec go test ./... "$@"
